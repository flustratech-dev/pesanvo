{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "your-org/pesanvo",
    "type": "project",
    "description": "Pesanvo Gateway — gateway WhatsApp terpusat multi-tenant untuk ekosistem Pesanvo.",
    "keywords": ["pesanvo", "whatsapp", "gateway"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "_comment_dev": "Laravel Pail sengaja tidak disertakan di sini: Pail butuh ekstensi pcntl yang tidak tersedia di PHP Windows, dan karena --kill-others, matinya Pail akan menjatuhkan seluruh proses lain. Jalankan `php artisan pail` di terminal terpisah bila memakai Linux/WSL.",
        "_comment_dev_migrate": "Migrasi dijalankan lebih dulu: kode baru yang berjalan di atas skema lama gagal di tempat yang tidak terduga -- admin yang identitasnya dipindahkan lewat migrasi tidak bisa masuk sama sekali.",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan migrate --ansi",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#34d399\" \"php artisan serve --port=8051\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" \"npm --prefix engine run dev\" --names=server,queue,vite,engine --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
