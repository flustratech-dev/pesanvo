# --- Rahasia ---------------------------------------------------------------
# Semua varian .env diabaikan, KECUALI file *.example yang memang template
# tanpa nilai. Pola `!*.example` ditulis terakhir supaya menang atas `.env.*`.
.env
.env.*
/engine/.env
/engine/.env.*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example
!/engine/.env.example
!/engine/.env.development.example
!/engine/.env.staging.example
!/engine/.env.production.example

# --- Engine ----------------------------------------------------------------
/engine/node_modules

# Kredensial sesi WhatsApp. Tidak boleh pernah masuk git: isinya setara dengan
# akses penuh ke nomor yang bersangkutan. Di produksi tersimpan di persistent
# volume, bukan di working directory.
/engine/.wwebjs_auth
/engine/.wwebjs_cache
/engine/*.zip

